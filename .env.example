# ============================================================================
# TTB Label Verify — environment variables
# ============================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Label reader ---
# openai       — OpenAI API (default)
# azure-openai — Azure OpenAI in your own tenant (no new outbound domains)
# fake         — returns a fixed compliant reading; for offline demos only
LABEL_READER=openai
# Per-attempt timeout for one label, in milliseconds.
LABEL_READER_TIMEOUT_MS=15000

# --- OpenAI (LABEL_READER=openai) ---
OPENAI_API_KEY=sk-...
# Vision model. Defaults to gpt-5.4-mini.
OPENAI_VLM_MODEL=
# Re-reads a warning that looks wrong before failing the label. Defaults to gpt-5.4.
OPENAI_WARNING_MODEL=
# Optional reasoning effort for reasoning models: none | minimal | low | medium | high.
OPENAI_REASONING_EFFORT=

# --- Azure OpenAI (LABEL_READER=azure-openai) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=your-vision-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Browser: labels checked at once ---
# Each label is its own server request, so this is the number of parallel workers.
NEXT_PUBLIC_VERIFY_CONCURRENCY=6

# --- Optional: Postgres (Neon) ---
# Leave blank to keep results in server memory (local demos only).
# After setting this, run: npm run db:migrate
DATABASE_URL=

# --- Optional: Langfuse tracing of model calls ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
